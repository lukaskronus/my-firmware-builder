	pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupt-parent = <0x02>;
		interrupts = <0x00 0x08 0x04 0x00 0x09 0x04 0x00 0x0a 0x04 0x00 0x0b 0x04>;
		interrupt-affinity = <0x0f 0x10 0x11 0x12>;
	};

	cpus {
		enable-method = "hisilicon,hi3798-smp";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@3 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			phandle = <0x12>;
			reg = <0x03>;
		};

		cpu@1 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			phandle = <0x10>;
			reg = <0x01>;
		};

		cpu@2 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			phandle = <0x11>;
			reg = <0x02>;
		};

		cpu@0 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			phandle = <0x0f>;
			reg = <0x00>;
		};
	};
