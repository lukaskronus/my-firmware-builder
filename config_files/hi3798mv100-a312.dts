/dts-v1/;

/ {
	compatible = "hisilicon,hi3798mv100";
	model = "Huawei EC6108V9C";
	#address-cells = <0x01>;
	#size-cells = <0x01>;

	i2c-hdmi {
		i2c-gpio,scl-open-drain;
		i2c-gpio,sda-open-drain;
		compatible = "i2c-gpio";
		scl-gpios = <0x01 0x05 0x06>;
		sda-gpios = <0x01 0x04 0x06>;
		status = "disabled";
		i2c-gpio,delay-us = <0x02>;
	};

	xtal24mhz@24M {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		phandle = <0x06>;
		clock-frequency = <0x16e3600>;
	};

	leds {
		compatible = "gpio-leds";

		ir {
			gpios = <0x15 0x02 0x00>;
			label = "green:ir";
			panic-indicator;
			default-state = "off";
		};

		network-activity {
			gpios = <0x14 0x02 0x00>;
			label = "red:network";
			default-state = "off";
		};

		network {
			gpios = <0x13 0x04 0x00>;
			label = "green:network";
			default-state = "off";
		};
	};

	aliases {
		serial0 = "/soc@f0000000/apb/uart@8b00000";
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyAMA0,115200 earlycon earlyprintk root=/dev/mmcblk0p9 rootfstype=ext4 rootwait blkdevparts=mmcblk0:1M(boot),1M(bootargs),4M(baseparam),4M(pqparam),4M(logo),20M(kernel),64M(busybox),512M(backup),-(ubuntu) mem=1G vmalloc=500M mmz=ddr,0,0,256M";
	};

	interrupt-controller@f8a01000 {
		compatible = "arm,cortex-a7-gic";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		phandle = <0x02>;
		reg = <0xf8a01000 0x1000 0xf8a02000 0x100>;
		interrupt-controller;
	};

	memory {
		reg = <0x00 0x40000000>;
	};

	soc@f0000000 {
		compatible = "simple-bus";
		ranges = <0x00 0xf0000000 0x10000000>;
		interrupt-parent = <0x02>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;

		pinconf@8a21000 {
			compatible = "pinconf-single";
			pinctrl-single,function-mask = <0x07>;
			pinctrl-single,register-width = <0x20>;
			#pinctrl-cells = <0x01>;
			phandle = <0x07>;
			pinctrl-single,gpio-range = <0x05 0x08 0x03 0x02 0x05 0x4f 0x01 0x00 0x05 0x15 0x04 0x05 0x05 0x19 0x01 0x05 0x05 0x36 0x01 0x02 0x05 0x37 0x02 0x00 0x05 0x4e 0x01 0x01 0x05 0x1f 0x01 0x06 0x05 0x20 0x01 0x01 0x05 0x39 0x08 0x00 0x05 0x50 0x02 0x00 0x05 0x2b 0x01 0x02 0x05 0x2c 0x01 0x00 0x05 0x2d 0x04 0x02 0x05 0x52 0x08 0x00>;
			reg = <0x8a21000 0x180>;

			emmc {

				emmc-rst {
					pinctrl-single,slew-rate = <0x100 0x100>;
					pinctrl-single,pins = <0x34 0x01>;
					pinctrl-single,drive-strength = <0x600 0x600>;
					pinctrl-single,bias-pullup = <0x00 0x1000 0x00 0x1000>;
				};

				emmc-cwpr {
					pinctrl-single,pins = <0x28 0x01>;
				};

				emmc-detect {
					pinctrl-single,bias-pulldown = <0x00 0x1000 0x00 0x1000>;
					pinctrl-single,slew-rate = <0x100 0x100>;
					pinctrl-single,pins = <0x20 0x01 0x24 0x01>;
					pinctrl-single,drive-strength = <0x600 0x600>;
				};

				emmc-ccmd {
					pinctrl-single,slew-rate = <0x100 0x100>;
					pinctrl-single,pins = <0x2c 0x01>;
					pinctrl-single,drive-strength = <0xc00 0xe00>;
					pinctrl-single,bias-pullup = <0x00 0x1000 0x00 0x1000>;
				};

				emmc-data {
					pinctrl-single,bias-pulldown = <0x00 0x1000 0x00 0x1000>;
					pinctrl-single,slew-rate = <0x100 0x100>;
					pinctrl-single,pins = <0x00 0x01 0x04 0x01 0x08 0x01 0x0c 0x01 0x10 0x01 0x14 0x01 0x18 0x01 0x1c 0x01>;
					pinctrl-single,drive-strength = <0xc00 0xe00>;
				};

				emmc-cclk-out {
					pinctrl-single,bias-pulldown = <0x00 0x1000 0x00 0x1000>;
					pinctrl-single,slew-rate = <0x100 0x100>;
					pinctrl-single,pins = <0x30 0x01>;
					pinctrl-single,drive-strength = <0xa00 0xe00>;
				};
			};

			gpio-range {
				#pinctrl-single,gpio-range-cells = <0x03>;
				phandle = <0x05>;
			};

			hdmi {

				hdmi-hotplug {
					pinctrl-single,pins = <0xbc 0x01>;
					phandle = <0x08>;
				};
			};
		};

		system-controller@8000000 {
			compatible = "hisilicon,hi3798mv100-sysctrl", "syscon";
			#reset-cells = <0x02>;
			#clock-cells = <0x01>;
			phandle = <0x03>;
			reg = <0x8000000 0x1000>;
		};

		reboot {
			compatible = "syscon-reboot";
			mask = <0xdeadbeef>;
			offset = <0x04>;
			regmap = <0x03>;
		};

		clock-reset-controller@8a22000 {
			compatible = "hisilicon,hi3798mv100-crg", "hisilicon,cpuctrl", "syscon", "simple-mfd";
			#reset-cells = <0x02>;
			#clock-cells = <0x01>;
			phandle = <0x04>;
			reg = <0x8a22000 0x2000>;
		};

		peripheral-controller@8a20000 {
			compatible = "syscon", "simple-mfd";
			ranges = <0x00 0x8a20000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x8a20000 0x1000>;

			phy@850 {
				compatible = "hisilicon,hi3798cv200-combphy";
				clocks = <0x04 0x2a>;
				resets = <0x04 0x188 0x04>;
				hisilicon,fixed-mode = <0x04>;
				status = "disabled";
				assigned-clock-rates = <0x5f5e100>;
				assigned-clocks = <0x04 0x2a>;
				reg = <0x850 0x08>;
				#phy-cells = <0x01>;
			};

			usb2-phy@158 {
				compatible = "hisilicon,hi3798mv100-usb2-phy";
				clocks = <0x04 0x3b>;
				resets = <0x04 0x190 0x08>;
				status = "okay";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x158 0x04>;

				phy@0 {
					resets = <0x04 0x190 0x09>;
					phandle = <0x0d>;
					reg = <0x00>;
					#phy-cells = <0x00>;
				};
			};

			usb2-phy@124 {
				compatible = "hisilicon,hi3798mv100-usb2-phy";
				clocks = <0x04 0x28>;
				resets = <0x04 0xbc 0x08>;
				status = "okay";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x124 0x04>;

				phy@1 {
					resets = <0x04 0xbc 0x0b>;
					phandle = <0x0c>;
					reg = <0x01>;
					#phy-cells = <0x00>;
				};

				phy@0 {
					resets = <0x04 0xbc 0x09>;
					phandle = <0x0b>;
					reg = <0x00>;
					#phy-cells = <0x00>;
				};
			};

			phy@858 {
				compatible = "hisilicon,hi3798cv200-combphy";
				clocks = <0x04 0x21>;
				resets = <0x04 0x188 0x0c>;
				hisilicon,mode-select-bits = <0x08 0x0b 0x1800>;
				status = "disabled";
				assigned-clock-rates = <0x5f5e100>;
				assigned-clocks = <0x04 0x21>;
				phandle = <0x0a>;
				reg = <0x858 0x08>;
				#phy-cells = <0x01>;
			};
		};

		mdio@9841100 {
			compatible = "hisilicon,hisi-femac-mdio";
			clocks = <0x04 0x3d>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x9841100 0x10>;

			phy@1 {
				mac-address = [00 00 00 00 00 00];
				phandle = <0x0e>;
				reg = <0x01>;
			};
		};

		rng@8005000 {
			compatible = "hisilicon,histb-rng";
			reg = <0x8005000 0x0c>;
		};

		ahb {
			compatible = "simple-bus";
			ranges;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			usb@9930000 {
				compatible = "generic-ehci";
				clocks = <0x04 0x34 0x04 0x35 0x04 0x36>;
				resets = <0x04 0x198 0x0c 0x04 0x198 0x10 0x04 0x198 0x0e>;
				clock-names = "bus", "phy", "utmi";
				phy-names = "usb";
				status = "okay";
				interrupts = <0x00 0x3e 0x04>;
				phys = <0x0d>;
				reg = <0x9930000 0x10000>;
				reset-names = "bus", "phy", "utmi";
			};

			usb@98a0000 {
				compatible = "generic-xhci";
				clocks = <0x04 0x2b 0x04 0x2c 0x04 0x2d 0x04 0x2e>;
				resets = <0x04 0xb0 0x0c>;
				clock-names = "bus", "utmi0", "pipe", "suspend";
				status = "disabled";
				interrupts = <0x00 0x45 0x04>;
				reg = <0x98a0000 0x10000>;
				reset-names = "vcc";
			};

			dmac@9870000 {
				compatible = "hisilicon,hi3798mv100-dmac";
				clocks = <0x04 0x40>;
				resets = <0x04 0xa4 0x04>;
				status = "okay";
				interrupts = <0x00 0x1e 0x04>;
				reg = <0x9870000 0x10000>;
			};

			usb@9880000 {
				compatible = "generic-ohci";
				clocks = <0x04 0x22 0x04 0x25 0x04 0x26>;
				resets = <0x04 0xb8 0x0c>;
				clock-names = "bus", "clk12", "clk48";
				phy-names = "usb0", "usb1";
				status = "okay";
				interrupts = <0x00 0x43 0x04>;
				phys = <0x0b 0x0c>;
				reg = <0x9880000 0x10000>;
				reset-names = "bus";
			};

			nand@9810000 {
				compatible = "hisilicon,hinfc610";
				resets = <0x04 0x60 0x04>;
				clock-names = "apb_pclk";
				status = "disabled";
				reg = <0x9810000 0x100 0xf000000 0x2176>;
				reset-names = "reset";
			};

			mmc@9820000 {
				compatible = "snps,dw-mshc";
				clocks = <0x04 0x16 0x04 0x15>;
				resets = <0x04 0x9c 0x04>;
				clock-names = "ciu", "biu";
				status = "disabled";
				interrupts = <0x00 0x22 0x04>;
				reg = <0x9820000 0x10000>;
				reset-names = "reset";
			};

			usb@9890000 {
				compatible = "generic-ehci";
				clocks = <0x04 0x22 0x04 0x23 0x04 0x24 0x04 0x33>;
				resets = <0x04 0xb8 0x0c 0x04 0xb8 0x10 0x04 0xb8 0x0d 0x04 0xb8 0x0e>;
				clock-names = "bus", "phy", "utmi0", "utmi1";
				phy-names = "usb0", "usb1";
				status = "okay";
				interrupts = <0x00 0x42 0x04>;
				phys = <0x0b 0x0c>;
				reg = <0x9890000 0x10000>;
				reset-names = "bus", "phy", "utmi0", "utmi1";
			};

			usb@9920000 {
				compatible = "generic-ohci";
				clocks = <0x04 0x34 0x04 0x38 0x04 0x39>;
				resets = <0x04 0x198 0x0c>;
				clock-names = "bus", "clk12", "clk48";
				phy-names = "usb";
				status = "okay";
				interrupts = <0x00 0x3f 0x04>;
				phys = <0x0d>;
				reg = <0x9920000 0x10000>;
				reset-names = "bus";
			};

			mmc@9830000 {
				cap-mmc-highspeed;
				compatible = "hisilicon,hi3798cv200-dw-mshc";
				clocks = <0x04 0x12 0x04 0x11 0x04 0x14 0x04 0x13>;
				resets = <0x04 0xa0 0x04>;
				clock-names = "ciu", "biu", "ciu-sample", "ciu-drive";
				fifo-depth = <0x100>;
				status = "okay";
				interrupts = <0x00 0x23 0x04>;
				reg = <0x9830000 0x10000>;
				clock-frequency = <0x5f5e100>;
				reset-names = "reset";
				non-removable;
					bus-width = <0x08>;
					max-frequency = <0x3200000>;
			};

			pcie@9860000 {
				compatible = "hisilicon,hi3798cv200-pcie";
				clocks = <0x04 0x19 0x04 0x1a 0x04 0x1b 0x04 0x1c>;
				resets = <0x04 0x18c 0x06 0x04 0x18c 0x05 0x04 0x18c 0x04>;
				reg-names = "control", "rc-dbi", "config";
				device_type = "pci";
				num-lanes = <0x01>;
				clock-names = "aux", "pipe", "sys", "bus";
				interrupt-map-mask = <0x00 0x00 0x00 0x00>;
				phy-names = "phy";
				ranges = <0x81000000 0x00 0x00 0x4f00000 0x00 0x100000 0x82000000 0x00 0x3000000 0x3000000 0x00 0x1f00000>;
				status = "disabled";
				#interrupt-cells = <0x01>;
				bus-range = <0x00 0xff>;
				#address-cells = <0x03>;
				interrupts = <0x00 0x80 0x04>;
				interrupt-map = <0x00 0x00 0x00 0x00 0x02 0x00 0x83 0x04>;
				#size-cells = <0x02>;
				phys = <0x0a 0x02>;
				reg = <0x9860000 0x1000 0x00 0x2000 0x2000000 0x1000000>;
				reset-names = "soft", "sys", "bus";
				interrupt-names = "msi";
			};

			gpu@9200000 {
				cooling-min-state = <0x00>;
				pmu_domain_config = <0x01 0x02 0x02 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x02 0x00>;
				compatible = "arm,mali-450", "arm,mali-utgard";
				clocks = <0x04 0x3e 0x04 0x3f>;
				resets = <0x04 0xd4 0x04>;
				clock-names = "bus", "core";
				status = "okay";
				interrupts = <0x00 0x5e 0x04 0x00 0x5e 0x04 0x00 0x5e 0x04 0x00 0x5e 0x04 0x00 0x5e 0x04 0x00 0x5e 0x04 0x00 0x5e 0x04 0x00 0x5e 0x04>;
				mali-supply = <0x09>;
				reg = <0x9200000 0x30000>;
				cooling-max-state = <0x07>;
				operating-points = <0x249f0 0x00 0x30d40 0x00 0x3d090 0x00 0x493e0 0x00 0x54600 0x00 0x61a80 0x00 0x69780 0x00 0x7a120 0x00>;
				#cooling-cells = <0x02>;
				interrupt-names = "gp", "gpmmu", "pp0", "ppmmu0", "pp1", "ppmmu1", "pmu", "pp";
				pmu_switch_delay = <0x1ff>;
			};
		};

		ethernet@9840000 {
			phy-handle = <0x0e>;
			compatible = "hisilicon,hisi-femac-v2";
			clocks = <0x04 0x1d>;
			hisilicon,phy-reset-delays-us = <0x2710 0x2710 0x4e20>;
			resets = <0x04 0xcc 0x04 0x04 0x120 0x04>;
			status = "okay";
			interrupts = <0x00 0x47 0x04>;
			reg = <0x9840000 0x1000 0x9841300 0x200>;
			phy-mode = "mii";
			reset-names = "mac", "phy";
		};

		apb {
			compatible = "simple-bus";
			ranges;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			watchdog@8a2c000 {
				compatible = "arm,sp805-wdt", "arm,primecell";
				clocks = <0x04 0x01>;
				clock-names = "apb_pclk";
				status = "okay";
				interrupts = <0x00 0x1d 0x04>;
				arm,primecell-periphid = <0x141805>;
				reg = <0x8a2c000 0x1000>;
			};

			cipher@9a00000 {
				compatible = "hisilicon,hi3798mv100-advca-muc";
				reg-names = "base", "mmu";
				interrupts = <0x00 0x4b 0x04 0x00 0x7e 0x04>;
				reg = <0x9a00000 0x10000 0x99f0000 0x1000>;
				interrupt-names = "base", "secure";
			};

			timer@8a2a000 {
				compatible = "arm,sp804", "arm,primecell";
				clocks = <0x06>;
				clock-names = "apb_pclk";
				status = "disabled";
				interrupts = <0x00 0x1a 0x04 0x00 0x3b 0x04>;
				reg = <0x8a2a000 0x1000>;
			};

			uart@8b02000 {
				compatible = "arm,pl011", "arm,primecell";
				clocks = <0x04 0x04 0x04 0x04>;
				resets = <0x04 0x68 0x05>;
				clock-names = "uartclk", "apb_pclk";
				status = "disabled";
				interrupts = <0x00 0x33 0x04>;
				reg = <0x8b02000 0x1000>;
				reset-names = "reset";
			};

			gpio@8b2a000 {
				compatible = "arm,pl061", "arm,primecell";
				clocks = <0x04 0x01>;
				clock-names = "apb_pclk";
				gpio-controller;
				status = "disabled";
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x76 0x04>;
				ngpios = <0x08>;
				reg = <0x8b2a000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			i2c@8b12000 {
				compatible = "hisilicon,hix5hd2-i2c";
				clocks = <0x04 0x08>;
				resets = <0x04 0x6c 0x0d>;
				status = "disabled";
				interrupts = <0x00 0x28 0x04>;
				reg = <0x8b12000 0x1000>;
				clock-frequency = <0x61a80>;
				reset-names = "reset";
			};

			timer@8002000 {
				compatible = "arm,sp804", "arm,primecell";
				clocks = <0x06>;
				clock-names = "apb_pclk";
				status = "disabled";
				interrupts = <0x00 0x18 0x04>;
				reg = <0x8002000 0x1000>;
			};

			gpio@8b27000 {
				compatible = "arm,pl061", "arm,primecell";
				clocks = <0x04 0x01>;
				clock-names = "apb_pclk";
				gpio-controller;
				status = "disabled";
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x73 0x04>;
				ngpios = <0x08>;
				reg = <0x8b27000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			regulator@8a23020 {
				compatible = "hisilicon,histb-volt";
				phandle = <0x09>;
				regulator-min-microvolt = <0xaae60>;
				reg = <0x8a23020 0x04>;
				regulator-max-microvolt = <0x1312d0>;
				regulator-always-on;
				regulator-name = "vdd-gpu";
			};

			gpio@8b24000 {
				compatible = "arm,pl061", "arm,primecell";
				clocks = <0x04 0x01>;
				gpio-line-names = "GPIO4_0", "GPIO4_1", "GPIO4_2", "GPIO4_3", "GPIO4_4", "GPIO4_5", "GPIO4_6", "GPIO4_7";
				clock-names = "apb_pclk";
				gpio-controller;
				gpio-ranges = <0x07 0x00 0x50 0x02>;
				status = "okay";
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x70 0x04>;
				ngpios = <0x08>;
				phandle = <0x01>;
				reg = <0x8b24000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			gpio@8b21000 {
				compatible = "arm,pl061", "arm,primecell";
				clocks = <0x04 0x01>;
				clock-names = "apb_pclk";
				gpio-controller;
				status = "disabled";
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x6d 0x04>;
				ngpios = <0x08>;
				reg = <0x8b21000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			ir@8001000 {
				compatible = "hisilicon,hix5hd2-ir";
				clocks = <0x03 0x02>;
				resets = <0x03 0x48 0x05>;
				clock-names = "apb_pclk";
				status = "okay";
				interrupts = <0x00 0x2f 0x04>;
				reg = <0x8001000 0x1000>;
				reset-names = "reset";
			};

			hash@9a10000 {
				compatible = "hisilicon,hi3798mv100-advca-sha";
				resets = <0x04 0xc4 0x04>;
				status = "okay";
				reg = <0x9a10000 0x1000>;
			};

			gpio@8b2c000 {
				compatible = "arm,pl061", "arm,primecell";
				clocks = <0x04 0x01>;
				clock-names = "apb_pclk";
				gpio-controller;
				status = "disabled";
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x78 0x04>;
				ngpios = <0x08>;
				reg = <0x8b2c000 0x1000>;
				#gpio-cells = <0x02>;
				interrupt-controller;
			};

			spi@8b1a000 {
				compatible = "arm,pl022", "arm,primecell";
				clocks = <0x04 0x0c 0x04 0x0c>;
				resets = <0x04 0x70 0x01>;
				clock-names = "sspclk", "apb_pclk";
				status = "disabled";
				interrupts = <0x00 0x2d 0x04>;
