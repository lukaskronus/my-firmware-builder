// SPDX-License-Identifier: GPL-2.0
/*
 * Device Tree for Hi3798MV100-based board
 * Adapted from vendor kernel 4.4 dump for histb-mainline kernel.
 *
 * Clock symbols verified against the real histb-clock.h from
 * histb-mainline/linux (histb branch). All HISTB_* references
 * use only symbols that actually exist in that header.
 *
 * To build, add to arch/arm/boot/dts/hisilicon/Makefile:
 *   dtb-$(CONFIG_ARCH_HISI) += hi3798mv100-dump.dtb
 */

/dts-v1/;
#include <dt-bindings/clock/histb-clock.h>

/ {
	model = "Hi3798MV100 Board";
	compatible = "hisilicon,hi3798mv100-board", "hisilicon,hi3798mv100";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&gic>;

	/* ------------------------------------------------------------------ */
	/* Chosen — update root= to match your actual partition                */
	/* ------------------------------------------------------------------ */
	chosen {
		bootargs = "mem=1G console=ttyAMA0,115200 root=/dev/mmcblk0p9 rootfstype=ext4 rootwait";
	};

	/* ------------------------------------------------------------------ */
	/* CPUs                                                                */
	/* ------------------------------------------------------------------ */
	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0>;
			enable-method = "psci";
		};
		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <1>;
			enable-method = "psci";
		};
		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <2>;
			enable-method = "psci";
		};
		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <3>;
			enable-method = "psci";
		};
	};

	/* ------------------------------------------------------------------ */
	/* Fixed clocks — taken directly from vendor dump                      */
	/* ------------------------------------------------------------------ */
	clocks {
		xtal_clk: xtal-clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <24000000>;
			clock-output-names = "clk24M";
		};

		clk_83p3m: clk-83p3m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <83333333>;
			clock-output-names = "clk83.3M";
		};

		clk_3m: clk-3m {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <3000000>;
			clock-output-names = "clk3M";
		};
	};

	/* ------------------------------------------------------------------ */
	/* GIC — addresses from vendor dump                                    */
	/* ------------------------------------------------------------------ */
	gic: interrupt-controller@f8a01000 {
		compatible = "arm,cortex-a7-gic";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0xf8a01000 0x1000>,
		      <0xf8a02000 0x100>;
	};

	/* ------------------------------------------------------------------ */
	/* CRG — main clock/reset controller                                   */
	/* Replaces vendor "hi3798mv100.clock" node.                          */
	/* reg taken from vendor dump: 0xf8a22000 (CRG) + 0xf8a20000 (sysctrl)*/
	/* ------------------------------------------------------------------ */
	crg: clock-controller@f8a22000 {
		compatible = "hisilicon,hi3798mv100-crg";
		reg = <0xf8a22000 0x200>;
		#clock-cells = <1>;
		#reset-cells = <2>;
	};

	/* MCU CRG — IR, timers, UART0 live here (separate phandle in header) */
	sysctrl: system-controller@f8a20000 {
		compatible = "hisilicon,hi3798mv100-sysctrl";
		reg = <0xf8a20000 0x848>;
		#clock-cells = <1>;
		#reset-cells = <2>;
	};

	/* ------------------------------------------------------------------ */
	/* SoC bus                                                             */
	/* ------------------------------------------------------------------ */
	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		/* ---------------------------------------------------------------- */
		/* AMBA / APB bus                                                    */
		/* ---------------------------------------------------------------- */
		amba {
			compatible = "arm,amba-bus";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			/* GPIO 0-4: APB base 0xf8b20000..f8b24000, IRQ 0x6c-0x70 */
			gpio0: gpio@f8b20000 {
				compatible = "arm,pl061", "arm,primecell";
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b20000 0x1000>;
				interrupts = <0 0x6c 4>;
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				clocks = <&xtal_clk>;
				clock-names = "apb_pclk";
			};

			gpio1: gpio@f8b21000 {
				compatible = "arm,pl061", "arm,primecell";
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b21000 0x1000>;
				interrupts = <0 0x6d 4>;
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				clocks = <&xtal_clk>;
				clock-names = "apb_pclk";
			};

			gpio2: gpio@f8b22000 {
				compatible = "arm,pl061", "arm,primecell";
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b22000 0x1000>;
				interrupts = <0 0x6e 4>;
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				clocks = <&xtal_clk>;
				clock-names = "apb_pclk";
			};

			gpio3: gpio@f8b23000 {
				compatible = "arm,pl061", "arm,primecell";
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b23000 0x1000>;
				interrupts = <0 0x6f 4>;
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				clocks = <&xtal_clk>;
				clock-names = "apb_pclk";
			};

			gpio4: gpio@f8b24000 {
				compatible = "arm,pl061", "arm,primecell";
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b24000 0x1000>;
				interrupts = <0 0x70 4>;
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				clocks = <&xtal_clk>;
				clock-names = "apb_pclk";
			};

			/* GPIO5 is at a different base in vendor dump */
			gpio5: gpio@f8004000 {
				compatible = "arm,pl061", "arm,primecell";
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8004000 0x1000>;
				interrupts = <0 0x71 0>;
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				clocks = <&xtal_clk>;
				clock-names = "apb_pclk";
			};

			gpio6: gpio@f8b26000 {
				compatible = "arm,pl061", "arm,primecell";
				arm,primecell-periphid = <0x41061>;
				reg = <0xf8b26000 0x1000>;
				interrupts = <0 0x72 4>;
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				clocks = <&xtal_clk>;
				clock-names = "apb_pclk";
			};

			watchdog@f8a2c000 {
				compatible = "arm,sp805-wdt", "arm,primecell";
				arm,primecell-periphid = <0x141805>;
				reg = <0xf8a2c000 0x1000>;
				clocks = <&xtal_clk>;
				clock-names = "apb_pclk";
			};

			/*
			 * I2C — HISTB_I2C0_CLK=6, I2C1=7, I2C2=8 (from crg)
			 * Verified present in histb-clock.h
			 */
			i2c0: i2c@f8b10000 {
				compatible = "hisilicon,hi-i2c";
				reg = <0xf8b10000 0x1000>;
				interrupts = <0 0x26 4>;
				clock-frequency = <400000>;
				clocks = <&crg HISTB_I2C0_CLK>;
				clock-names = "apb_pclk";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			i2c1: i2c@f8b11000 {
				compatible = "hisilicon,hi-i2c";
				reg = <0xf8b11000 0x1000>;
				interrupts = <0 0x27 4>;
				clock-frequency = <400000>;
				clocks = <&crg HISTB_I2C1_CLK>;
				clock-names = "apb_pclk";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			i2c2: i2c@f8b12000 {
				compatible = "hisilicon,hi-i2c";
				reg = <0xf8b12000 0x1000>;
				interrupts = <0 0x28 4>;
				clock-frequency = <400000>;
				clocks = <&crg HISTB_I2C2_CLK>;
				clock-names = "apb_pclk";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			/*
			 * SPI — HISTB_SPI0_CLK=12 (from crg)
			 * Verified present in histb-clock.h
			 */
			spi0: spi@f8b1a000 {
				compatible = "arm,pl022", "arm,primecell";
				arm,primecell-periphid = <0x41022>;
				interrupts = <0 0x2d 4>;
				reg = <0xf8b1a000 0x1000>;
				num-cs = <2>;
				#address-cells = <1>;
				#size-cells = <0>;
				clocks = <&crg HISTB_SPI0_CLK>;
				clock-names = "apb_pclk";
				pl022,rt;
			};

			/*
			 * IR — HISTB_IR_CLK=2 from sysctrl (MCU CRG)
			 * Verified present in histb-clock.h under MCU CRG section
			 */
			ir@f8001000 {
				compatible = "hisilicon,hix5hd2-ir";
				reg = <0xf8001000 0x1000>;
				interrupts = <0 0x2f 4>;
				clocks = <&sysctrl HISTB_IR_CLK>;
				linux,rc-map-name = "rc-hisi";
			};

			/*
			 * Timer — HISTB_TIMER01_CLK=3 from sysctrl (MCU CRG)
			 * Verified present in histb-clock.h under MCU CRG section
			 */
			timer@f8a29000 {
				compatible = "hisilicon,hisp804";
				reg = <0xf8a29000 0x20>,
				      <0xf8a2a000 0x20>,
				      <0xf8a2a020 0x20>,
				      <0xf8a2b000 0x20>,
				      <0xf8a2b020 0x20>;
				interrupts = <0 0x1a 4>, <0 0x3b 4>,
				             <0 0x1b 4>, <0 0x3c 4>;
				clocks = <&sysctrl HISTB_TIMER01_CLK>;
				clock-names = "apb_pclk";
			};

			/*
			 * UARTs
			 * UART0 (console, ttyAMA0): HISTB_UART0_CLK=5 from sysctrl
			 * UART1 (ttyAMA1): HISTB_UART1_CLK=3 from crg
			 * UART2 (ttyAMA2): HISTB_UART2_CLK=4 from crg
			 * All verified present in histb-clock.h
			 */
			uart0: uart@f8b00000 {
				compatible = "arm,pl011", "arm,primecell";
				reg = <0xf8b00000 0x1000>;
				interrupts = <0 0x31 4>;
				clocks = <&sysctrl HISTB_UART0_CLK>, <&clk_83p3m>;
				clock-names = "uartclk", "apb_pclk";
			};

			uart1: uart@f8006000 {
				compatible = "arm,pl011", "arm,primecell";
				reg = <0xf8006000 0x1000>;
				interrupts = <0 0x32 4>;
				clocks = <&crg HISTB_UART1_CLK>, <&clk_3m>;
				clock-names = "uartclk", "apb_pclk";
			};

			uart2: uart@f8b02000 {
				compatible = "arm,pl011", "arm,primecell";
				reg = <0xf8b02000 0x1000>;
				interrupts = <0 0x33 4>;
				clocks = <&crg HISTB_UART2_CLK>, <&clk_83p3m>;
				clock-names = "uartclk", "apb_pclk";
			};
		}; /* amba */

		/* ---------------------------------------------------------------- */
		/* eMMC                                                              */
		/* HISTB_MMC_BIU_CLK=17, CIU=18, DRV=19, SAMPLE=20                 */
		/* All four verified present in histb-clock.h                       */
		/* ---------------------------------------------------------------- */
		mmc@f9830000 {
			compatible = "hisilicon,hi3798mv100-dw-mshc",
			             "hisilicon,hi3798cv200-dw-mshc",
			             "snps,dw-mshc";
			reg = <0xf9830000 0x1000>;
			interrupts = <0 0x23 4>;
			clocks = <&crg HISTB_MMC_BIU_CLK>,
			         <&crg HISTB_MMC_CIU_CLK>,
			         <&crg HISTB_MMC_SAMPLE_CLK>,
			         <&crg HISTB_MMC_DRV_CLK>;
			clock-names = "biu", "ciu", "ciu-sample", "ciu-drive";
			bus-width = <8>;
			cap-mmc-highspeed;
			mmc-ddr-1_8v;
			non-removable;
			max-frequency = <100000000>;
		};

		/* ---------------------------------------------------------------- */
		/* SD card                                                           */
		/* HISTB_SDIO0_BIU_CLK=21, CIU=22, SAMPLE=24, DRV=23               */
		/* All four verified present in histb-clock.h                       */
		/* ---------------------------------------------------------------- */
		sd@f9820000 {
			compatible = "hisilicon,hi3798mv100-dw-mshc",
			             "hisilicon,hi3798cv200-dw-mshc",
			             "snps,dw-mshc";
			reg = <0xf9820000 0x1000>;
			interrupts = <0 0x22 4>;
			clocks = <&crg HISTB_SDIO0_BIU_CLK>,
			         <&crg HISTB_SDIO0_CIU_CLK>,
			         <&crg HISTB_SDIO0_SAMPLE_CLK>,
			         <&crg HISTB_SDIO0_DRV_CLK>;
			clock-names = "biu", "ciu", "ciu-sample", "ciu-drive";
			bus-width = <4>;
			cap-sd-highspeed;
			max-frequency = <100000000>;
		};

		/* ---------------------------------------------------------------- */
		/* Ethernet                                                          */
		/* HISTB_ETH0_MAC_CLK=29, HISTB_ETH0_MACIF_CLK=30                  */
		/* Verified present in histb-clock.h                                */
		/* NOTE: vendor used one clock offset 0xcc; mainline hieth driver   */
		/* may only need one clock — if it fails try removing macif_clk     */
		/* ---------------------------------------------------------------- */
		eth: ethernet@f9840000 {
			compatible = "hisilicon,hieth";
			reg = <0xf9840000 0x4000>;
			interrupts = <0 0x47 4>;
			clocks = <&crg HISTB_ETH0_MAC_CLK>,
			         <&crg HISTB_ETH0_MACIF_CLK>;
			clock-names = "clk_mac", "clk_macif";
			#address-cells = <1>;
			#size-cells = <0>;

			phy0: ethernet-phy@2 {
				reg = <2>;
				mac-address = [00 00 00 00 00 00];
				phy-mode = "mii";
				internal-phy;
			};
		};

		/* ---------------------------------------------------------------- */
		/* USB2 port 1 — EHCI + OHCI                                        */
		/* HISTB_USB2_BUS_CLK=34, PHY=35, UTMI=36, 12M=37, 48M=38         */
		/* All verified present in histb-clock.h                            */
		/* ---------------------------------------------------------------- */
		usb_ehci0: usb@f9890000 {
			compatible = "generic-ehci";
			reg = <0xf9890000 0x10000>;
			interrupts = <0 0x42 4>;
			clocks = <&crg HISTB_USB2_BUS_CLK>,
			         <&crg HISTB_USB2_PHY_CLK>,
			         <&crg HISTB_USB2_12M_CLK>,
			         <&crg HISTB_USB2_48M_CLK>,
			         <&crg HISTB_USB2_UTMI_CLK>;
			clock-names = "bus", "phy", "12m", "48m", "utmi";
		};

		usb_ohci0: usb@f9880000 {
			compatible = "generic-ohci";
			reg = <0xf9880000 0x10000>;
			interrupts = <0 0x43 4>;
			clocks = <&crg HISTB_USB2_BUS_CLK>,
			         <&crg HISTB_USB2_PHY_CLK>,
			         <&crg HISTB_USB2_12M_CLK>,
			         <&crg HISTB_USB2_48M_CLK>;
			clock-names = "bus", "phy", "12m", "48m";
		};

		/*
		 * USB2 port 2 — EHCI + OHCI (ehci@f9930000, ohci@f9920000)
		 * The vendor dump uses clock offset 0x198 for both.
		 * histb-clock.h has NO symbol for USB2 port 2 clocks yet.
		 * These nodes are disabled (status = "disabled") to avoid
		 * a clock binding failure. Enable them once the MV100 CRG
		 * driver adds support for USB2 port 2 clock IDs.
		 */
		usb_ehci1: usb@f9930000 {
			compatible = "generic-ehci";
			reg = <0xf9930000 0x10000>;
			interrupts = <0 0x3e 4>;
			clocks = <&crg HISTB_USB2_BUS_CLK>;
			clock-names = "bus";
			status = "disabled";
		};

		usb_ohci1: usb@f9920000 {
			compatible = "generic-ohci";
			reg = <0xf9920000 0x10000>;
			interrupts = <0 0x3f 4>;
			clocks = <&crg HISTB_USB2_BUS_CLK>;
			clock-names = "bus";
			status = "disabled";
		};

		/* ---------------------------------------------------------------- */
		/* USB3 xHCI                                                         */
		/* HISTB_USB3_BUS_CLK=43, UTMI=44, PIPE=45, SUSPEND=46             */
		/* All verified present in histb-clock.h                            */
		/* ---------------------------------------------------------------- */
		usb_xhci: usb@f98a0000 {
			compatible = "generic-xhci";
			reg = <0xf98a0000 0x10000>;
			interrupts = <0 0x45 4>;
			clocks = <&crg HISTB_USB3_BUS_CLK>,
			         <&crg HISTB_USB3_UTMI_CLK>,
			         <&crg HISTB_USB3_PIPE_CLK>,
			         <&crg HISTB_USB3_SUSPEND_CLK>;
			clock-names = "bus", "utmi", "pipe", "suspend";
		};

	}; /* soc */
};
